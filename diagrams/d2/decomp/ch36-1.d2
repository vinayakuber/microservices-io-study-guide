    font-size: 16
  }
}

P0: {
  label: |md
    collects the lines shipped by each service
  |
  shape: rectangle
  style: {
    fill: "#1f6feb"
    stroke: "#388bfd"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 15
  }
}

P1: {
  label: |md
    indexes them by request id into {"REQ-3001":\[1,2,3\]}
  |
  shape: rectangle
  style: {
    fill: "#1f6feb"
    stroke: "#388bfd"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 15
  }
}

R -> P0: "1. comprises"
R -> P1: "2. comprises"
