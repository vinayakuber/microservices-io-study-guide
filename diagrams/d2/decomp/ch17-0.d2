direction: down

R: {
  label: |md
    **Order aggregate (in Order Service) — the publisher**
  |
  shape: rectangle
  style: {
    fill: "#238636"
    stroke: "#2ea043"
    font-color: "#FFFFFF"
    border-radius: 8
    font-size: 16
  }
}

P0: {
  label: |md
    change state — flips order state "NEW" -> "PLACED"
  |
  shape: rectangle
  style: {
    fill: "#1f6feb"
    stroke: "#388bfd"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 15
  }
}

P1: {
  label: |md
    emit DomainEvent — produces "OrderPlaced" { order\_id:"PO-2001" }
  |
  shape: rectangle
  style: {
    fill: "#1f6feb"
    stroke: "#388bfd"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 15
  }
}

P2: {
  label: |md
    Transactional Outbox — writes the event row in the same DB transaction
  |
  shape: rectangle
  style: {
    fill: "#1f6feb"
    stroke: "#388bfd"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 15
  }
}

P3: {
  label: |md
    Relay — polls the outbox after commit and publishes to the broker
  |
  shape: rectangle
  style: {
    fill: "#1f6feb"
    stroke: "#388bfd"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 15
  }
}

R -> P0: "1. comprises"
R -> P1: "2. comprises"
R -> P2: "3. comprises"
R -> P3: "4. comprises"
