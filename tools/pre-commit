#!/usr/bin/env bash
# Refuse a commit if the explain-program gate fails (R1-R16) or any mermaid
# block fails to parse/validate.
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

node tools/explain_program_gate.js || {
  echo "COMMIT BLOCKED: explain-program gate failed. Fix the reported blocks, then re-commit." >&2
  exit 1
}

node tools/validate_mermaid.js || {
  echo "COMMIT BLOCKED: a mermaid diagram failed validation. Fix the reported block, then re-commit." >&2
  exit 1
}

exit 0
